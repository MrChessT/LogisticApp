NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# Solo servidor (nunca NEXT_PUBLIC_): invitar al equipo crea la cuenta y su enlace de acceso.
# En local: `npx supabase status -o env` → SERVICE_ROLE_KEY. En Vercel: variable Sensitive.
SUPABASE_SERVICE_ROLE_KEY=

# Asistente de LogisticApp. Recomendado: TYPESAFE_API_KEY (Jev directo, ~0,2 s por llamada; también
# en Vercel como variable Sensitive). Sin ella, Jev va por Vercel AI Gateway: AI_GATEWAY_API_KEY o, en
# Vercel, el token OIDC del despliegue (en local, `vercel link` + `vercel env pull` crean VERCEL_OIDC_TOKEN).
# TYPESAFE_API_KEY=
# AI_GATEWAY_API_KEY=
# Redacción con LLM (opcional; por defecto plantillas): WRITER_PROVIDER=openai, WRITER_URL=https://ai-gateway.vercel.sh, WRITER_MODEL=<modelo>
